# Скопируй этот файл в .env.local и заполни своими значениями.
# .env.local никогда не попадёт в Git (уже в .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret-ключ, ТОЛЬКО для сервера — нужен, чтобы менеджер мог создавать
# логины сотрудников прямо из интерфейса. Никогда не используется в браузере.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter → openrouter.ai/keys → Create key (бесплатно, без карты)
OPENROUTER_API_KEY=

# Только для `npm run check:rls` (проверка политик RLS), не нужен для работы сайта.
# Supabase → Project Settings → Database → Connection string → "Session pooler".
# Не коммитить реальное значение — секрет уровня пароля от базы.
SUPABASE_DB_URL=
